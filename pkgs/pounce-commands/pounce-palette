#!/bin/bash
# pounce-palette — THE palette launcher, for every packaging of pounce.
#
# Scans the command dirs, reads each script's `# pounce: key = value` header to
# build the registry (name \t description \t icon \t id \t submenu \t mutates \t
# confirm \t network), hands the merged list to `pounce --launcher` (which adds
# installed apps natively), and execs whatever command comes back.
#
# Packagers wrap this script with environment, they don't edit it:
#
#   POUNCE_BUILTIN_DIR          the built-in command set
#                               (default: <this script's dir>/../share/pounce/commands,
#                                which is the Homebrew keg layout)
#   POUNCE_EXTRA_COMMAND_DIRS   colon-separated dirs a packager layers on
#                               (how Nix consumers' extraCommandDirs arrive)
#   POUNCE_COMMAND_PATH         colon-separated dirs for ad-hoc user layering
#
# Discovery order (later shadows earlier, by filename):
#   builtin -> POUNCE_EXTRA_COMMAND_DIRS -> POUNCE_COMMAND_PATH -> ~/.config/pounce/commands
#
# Kept bash-3.2 compatible (macOS /bin/bash): the id -> script map is a tmpdir
# of symlinks rather than an associative array.
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PATH="$HERE:$PATH"   # the pounce binary is installed alongside this script

MAP="$(mktemp -d "${TMPDIR:-/tmp}/pounce-palette.XXXXXX")"
trap 'rm -rf "$MAP"' EXIT

scan() { # scan <dir> — later calls shadow earlier .sh commands by filename
  local dir f id
  [ -d "$1" ] || return 0
  dir="$(cd "$1" && pwd)"   # absolute, so the map's symlinks survive exec
  # Submenu scripts commonly keep data files beside themselves. Restricting
  # discovery to the documented .sh command format keeps those resources out
  # of the top-level palette (and prevents us from trying to run them as bash).
  for f in "$dir"/*.sh; do
    [ -f "$f" ] || continue
    id="${f##*/}"
    id="${id%.sh}"
    ln -sf "$f" "$MAP/$id"
  done
}

scan "${POUNCE_BUILTIN_DIR:-$HERE/../share/pounce/commands}"
if [ -n "${POUNCE_EXTRA_COMMAND_DIRS:-}" ]; then
  IFS=: read -ra _dirs <<<"$POUNCE_EXTRA_COMMAND_DIRS"
  for d in "${_dirs[@]}"; do scan "$d"; done
fi
if [ -n "${POUNCE_COMMAND_PATH:-}" ]; then
  IFS=: read -ra _dirs <<<"$POUNCE_COMMAND_PATH"
  for d in "${_dirs[@]}"; do scan "$d"; done
fi
scan "${XDG_CONFIG_HOME:-$HOME/.config}/pounce/commands"

# Registry lines from each script's `# pounce: key = value` header.
# Missing name falls back to the id, missing icon to "sparkles".
# (The glob is sorted by bash, so the registry is stable.)
#
# `whenFile` is the one key this loop ACTS on rather than passes through: the
# named file is a veto, and a command whose file says `0` is left out. The daemon
# does the same in CommandRegistry.listed() — the two parsers have to agree, since
# ⌘Space goes through that one and this script is what a machine without the
# daemon (or the bar's logo pill) still runs. Only a literal `0` vetoes: no file,
# an unreadable one and an empty one all LIST the row, because a row that hides
# when nobody is answering hides forever with nothing in any log.
#
# It rides in FRONT of the registry line and is stripped here, so what pounce
# reads is the registry line itself and nothing else. Tabs are removed from the value in
# awk for that reason — one in a header would otherwise shift every field.
registry=$(
  for entry in "$MAP"/*; do
    [ -e "$entry" ] || continue
    id="${entry##*/}"
    # `NR > 30` comes FIRST so line 31 is not matched and then abandoned: the
    # daemon's parser breaks before processing it, and a `whenFile` on line 31
    # deciding a row here and not there is a row that is present on one path and
    # missing on the other. Values are right-trimmed for the same reason —
    # CommandRegistry's `field()` ends in `.trimmingCharacters`, and a trailing
    # space in a hand-written header is exactly what that is there for.
    # Whitespace-tolerant before `#`, around `pounce:`, and around `=` — to
    # match CommandRegistry.swift's parser (`value(of:)`/`field()`) and haus's
    # `commandField`. An indented header line or a stray second space after
    # `#` used to match some of the three parsers and not the others, which
    # a hand-typed header has no way to notice.
    line=$(awk -v id="$id" '
      NR > 30 { exit }   # headers live at the top; do not read whole files
      /^[ \t]*#[ \t]+pounce:[ \t]*name[ \t]*=/        && n == "" { sub(/^[ \t]*#[ \t]+pounce:[ \t]*name[ \t]*=[ \t]*/, "");        n = $0 }
      /^[ \t]*#[ \t]+pounce:[ \t]*description[ \t]*=/ && d == "" { sub(/^[ \t]*#[ \t]+pounce:[ \t]*description[ \t]*=[ \t]*/, ""); d = $0 }
      /^[ \t]*#[ \t]+pounce:[ \t]*icon[ \t]*=/        && i == "" { sub(/^[ \t]*#[ \t]+pounce:[ \t]*icon[ \t]*=[ \t]*/, "");        i = $0 }
      /^[ \t]*#[ \t]+pounce:[ \t]*submenu[ \t]*=/     && s == "" { sub(/^[ \t]*#[ \t]+pounce:[ \t]*submenu[ \t]*=[ \t]*/, "");     s = $0 }
      /^[ \t]*#[ \t]+pounce:[ \t]*whenFile[ \t]*=/    && w == "" { sub(/^[ \t]*#[ \t]+pounce:[ \t]*whenFile[ \t]*=[ \t]*/, "");    w = $0 }
      # What the command declares it will do (CommandRisk.swift): does it change
      # state, must the palette ask first, does it talk to the internet. Same
      # first-wins guard and same "true"/1 grammar as `submenu` — they ride the
      # registry line so the palette can put a confirm sheet in front of a
      # `confirm` command on THIS path too, not only under the daemon.
      /^[ \t]*#[ \t]+pounce:[ \t]*mutates[ \t]*=/     && m == "" { sub(/^[ \t]*#[ \t]+pounce:[ \t]*mutates[ \t]*=[ \t]*/, "");     m = $0 }
      /^[ \t]*#[ \t]+pounce:[ \t]*confirm[ \t]*=/     && c == "" { sub(/^[ \t]*#[ \t]+pounce:[ \t]*confirm[ \t]*=[ \t]*/, "");     c = $0 }
      /^[ \t]*#[ \t]+pounce:[ \t]*network[ \t]*=/     && k == "" { sub(/^[ \t]*#[ \t]+pounce:[ \t]*network[ \t]*=[ \t]*/, "");     k = $0 }
      END {
        if (n == "") n = id
        if (i == "") i = "sparkles"
        # `s` is trimmed with the rest even though it is never printed: it is
        # compared to the literal "true", so a trailing space made
        # `submenu = true ` a LEAF here and a submenu in the daemon (whose
        # field() ends in .trimmingCharacters) — the same command behaving
        # differently on the two paths, with nothing to see but a picker that
        # does not open. `m`/`c`/`k` are trimmed for the same reason, and `c`
        # is the one where the difference is a confirm sheet the user does or
        # does not get.
        sub(/[ \t]+$/, "", w); sub(/[ \t]+$/, "", n); sub(/[ \t]+$/, "", s)
        sub(/[ \t]+$/, "", d); sub(/[ \t]+$/, "", i)
        sub(/[ \t]+$/, "", m); sub(/[ \t]+$/, "", c); sub(/[ \t]+$/, "", k)
        gsub(/\t/, "", w); gsub(/\t/, " ", n); gsub(/\t/, " ", d); gsub(/\t/, "", i)
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", w, n, d, i, id, \
          (s == "true" || s == "1") ? "1" : "0", \
          (m == "true" || m == "1") ? "1" : "0", \
          (c == "true" || c == "1") ? "1" : "0", \
          (k == "true" || k == "1") ? "1" : "0"
      }
    ' "$entry")
    # An unreadable script produces nothing at all rather than a blank row.
    [ -n "$line" ] || continue
    when="${line%%$'\t'*}"
    if [ -n "$when" ]; then
      # The leading `(` on each pattern is REQUIRED, not style: bash 3.2 —
      # /bin/bash on macOS, and this script's shebang — mis-parses a bare `case`
      # pattern inside a `$( )`, and the whole file then dies with a syntax
      # error at load. `tests/run.sh` runs `/bin/bash -n` over this file for
      # exactly that reason; a `bash -n` from a modern bash on $PATH passes it.
      # Backslash-escaped rather than quoted. A quoted `~` is what SC2088 warns
      # about, and here the literal IS the point: the character arrived in a
      # header and this is the only thing that expands it.
      case "$when" in
        (\~) when="$HOME" ;;
        (\~/*) when="$HOME/${when#\~/}" ;;
      esac
      # `[ -f ]` and not just existence: a FIFO would block the read forever, and
      # `[ -r ]` keeps an unreadable one from writing to stderr (the redirection
      # order can't suppress it — `<"$file"` is applied before `2>/dev/null`).
      # Both are "cannot tell", so both list the row.
      if [ -f "$when" ] && [ -r "$when" ]; then
        # `read` over `head`: this loop is already a fork per command. One
        # variable, so the whole line lands in it with the surrounding
        # whitespace stripped — which is what `.trimmingCharacters` does on the
        # daemon's side. NOT `IFS=`, and NOT `%%[[:space:]]*`: either one makes
        # `0 pages` or ` 0` mean something different here than there.
        first=""
        read -r first <"$when"
        [ "$first" = 0 ] && continue
      fi
    fi
    printf '%s\n' "${line#*$'\t'}"
  done
)

# Launcher mode: apps are enumerated + launched natively inside pounce; the
# only thing that comes back here is a selected command ("run\t<id>").
selected=$(printf '%s\n' "$registry" | pounce --launcher --max-empty 7 \
  -p "Search apps & actions..." -i "magnifyingglass")

if [ -n "$selected" ]; then
  cmd_id=$(printf '%s' "$selected" | cut -f2)
  if [ -e "$MAP/$cmd_id" ]; then
    script="$(readlink "$MAP/$cmd_id")"
    # exec replaces this shell, so the EXIT trap won't fire — clean up first.
    rm -rf "$MAP"; trap - EXIT
    if [ -x "$script" ]; then exec "$script"; else exec bash "$script"; fi
  fi
fi
