#!/bin/bash
# pounce: name = Ports
# pounce: description = Kill Listening Ports
# pounce: icon = network
# pounce: submenu = true

# Draws through trill when this Mac has it, macOS's own banner when it doesn't.
# The bundle is resolved at call time rather than through a `trill` on PATH,
# because pounce installs standalone and cannot assume either. `--source` is
# what `~/.config/trill/rules.json` matches on, so this one command can be
# routed or silenced without silencing pounce. See AGENTS.md § Notifications.
#
#   notify <body> [kind] [sf-symbol]     kind: note (default) | fault | "done"
#
# Quote `done` when you pass it: it is a shell keyword, and unquoted it
# makes shellcheck read the line as a broken loop (SC1010).
#
# The kind is what trill colours the card by, so a failure and a confirmation
# do not arrive looking identical. macOS has nowhere to put either, which is
# why the fallback drops them rather than faking them.
notify() {
    local _bin
    # An array, not `${3:+--symbol "$3"}`: that form is word-split after
    # expansion, so a value with a space in it would arrive as two arguments.
    local _sym=()
    [ -n "${3:-}" ] && _sym=(--symbol "$3")
    for _bin in "${TRILL_APP:-}/Contents/MacOS/Trill" \
                "$HOME/Applications/Trill.app/Contents/MacOS/Trill" \
                "/Applications/Trill.app/Contents/MacOS/Trill"; do
        [ -x "$_bin" ] || continue
        "$_bin" send --kind "${2:-note}" "${_sym[@]}" --source pounce.ports --title "ports" --body "$1" \
            >/dev/null 2>&1 && return 0
        break
    done
    # `argv`, not interpolation: a body carrying a double quote would end the
    # AppleScript string early.
    osascript -e 'on run argv
          display notification (item 1 of argv) with title (item 2 of argv)
        end run' -- "$1" "ports" >/dev/null 2>&1
}

# Apps to ignore (common background processes)
IGNORE_PATTERN="ControlCe|rapportd|Raycast|figma_age|Linear|Elgato|Cursor|Spotify|Slack|Discord|Notion|1Password|Dropbox|Google|Adobe|Microsoft|ZoomOpener|com\.apple|sharingd|AirPlay|WiFiAgent|SystemUIServer|loginwindow|UserEvent|identityservicesd|CommCenter|GEOExtension"

# Get listening ports with process info, format as tab-separated: title\tsubtitle\ticon
get_ports() {
    lsof -iTCP -sTCP:LISTEN -P -n 2>/dev/null | tail -n +2 | grep -vE "$IGNORE_PATTERN" | while read -r line; do
        pid=$(echo "$line" | awk '{print $2}')
        port=$(echo "$line" | awk '{print $9}' | sed 's/.*://')
        cmd=$(echo "$line" | awk '{print $1}')

        # Try to get a better name from the process
        full_cmd=$(ps -p "$pid" -o args= 2>/dev/null | head -1)

        # Extract meaningful name and pick an icon
        icon="network"
        if [[ "$full_cmd" == *"node"* ]]; then
            # For node, try to get the script or package name
            if [[ "$full_cmd" == *"node_modules/.bin/"* ]]; then
                name=$(echo "$full_cmd" | grep -oE 'node_modules/\.bin/[^ ]+' | sed 's|node_modules/\.bin/||')
            else
                name=$(echo "$full_cmd" | grep -oE '[^ ]+\.js|node_modules/[^/]+' | head -1 | sed 's|node_modules/||')
            fi
            [[ -z "$name" ]] && name="node"
            icon="chevron.left.forwardslash.chevron.right"
        elif [[ "$full_cmd" == *"python"* ]]; then
            name=$(echo "$full_cmd" | grep -oE '[^ ]+\.py' | head -1)
            [[ -z "$name" ]] && name="python"
            icon="chevron.left.forwardslash.chevron.right"
        elif [[ "$full_cmd" == *"ruby"* ]]; then
            name=$(echo "$full_cmd" | grep -oE '[^ ]+\.rb' | head -1)
            [[ -z "$name" ]] && name="ruby"
            icon="chevron.left.forwardslash.chevron.right"
        elif [[ "$cmd" == "com.docke"* ]] || [[ "$full_cmd" == *"docker"* ]]; then
            name="docker"
            icon="shippingbox"
        elif [[ "$cmd" == "nginx"* ]]; then
            name="nginx"
            icon="server.rack"
        elif [[ "$cmd" == "postgres"* ]] || [[ "$cmd" == "postmaste"* ]]; then
            name="postgres"
            icon="cylinder"
        elif [[ "$cmd" == "redis"* ]]; then
            name="redis"
            icon="cylinder"
        elif [[ "$cmd" == "mysql"* ]]; then
            name="mysql"
            icon="cylinder"
        elif [[ "$cmd" == "mongod"* ]]; then
            name="mongodb"
            icon="cylinder"
        else
            # Fallback to command name, cleaned up
            name=$(basename "$(echo "$full_cmd" | awk '{print $1}')" 2>/dev/null)
            [[ -z "$name" ]] && name="$cmd"
        fi

        # Format: title<TAB>subtitle<TAB>icon
        # Title: ":port name", Subtitle: "pid XXXX"
        printf ":%-5s %s\t%s\t%s\n" "$port" "$name" "pid $pid" "$icon"
    done | sort -t: -k2 -n | uniq
}

# Get the list
ports=$(get_ports)

if [[ -z "$ports" ]]; then
    # Still show the picker for visual feedback — osascript notifications are
    # unreliable (macOS often drops them silently), so a notification alone
    # makes this look like nothing happened.
    printf 'No listening ports found\t(nothing to kill)\txmark.circle\n' | pounce
    exit 0
fi

# Show picker. pounce emits its selection as: action<TAB>title<TAB>subtitle<TAB>icon
selected=$(echo "$ports" | pounce)

if [[ -n "$selected" ]]; then
    # PID lives in the subtitle ("pid NNNN"), which is field 3 of pounce's
    # output (field 1 is the action, field 2 the title/":port name").
    pid=$(echo "$selected" | cut -f3 | grep -oE '[0-9]+')

    if [[ -n "$pid" ]]; then
        if kill -9 "$pid" 2>/dev/null; then
            notify "Killed process $pid" "done" checkmark.circle
        else
            notify "Failed to kill $pid" fault exclamationmark.triangle
        fi
    fi
fi
