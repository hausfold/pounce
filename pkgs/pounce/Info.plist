<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>pounce</string>
    <key>CFBundleIdentifier</key>
    <string>com.hausfold.pounce</string>
    <key>CFBundleDisplayName</key>
    <string>Pounce</string>
    <key>CFBundleName</key>
    <string>Pounce</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- AppIcon.icns is built by build.sh from AppIcon.iconset; it is not a
         checked-in file. Renaming one without the other leaves the bundle
         pointing at an icon that isn't there, which reads as a white squircle. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- The `pounce://` door (URLScheme.swift, URLHandler.swift). Registering
         the scheme is a BUNDLE fact — it is claimed the moment Launch Services
         sees this plist, before any setting is read — so the runtime switch
         that can actually close the door is config.json's `urlScheme.enabled`,
         which the daemon checks on every link.
         `Viewer` rather than `Editor`: pounce does not own these URLs, it acts
         on them. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.hausfold.pounce.run</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>pounce</string>
            </array>
        </dict>
    </array>
    <key>NSCameraUsageDescription</key>
    <string>Pounce shows a live camera preview for the camera peek command.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Pounce lists and connects Bluetooth devices for the bluetooth command.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Pounce's Lock Screen and Force Quit commands drive System Events; a command you write yourself may drive another app the same way.</string>
</dict>
</plist>
